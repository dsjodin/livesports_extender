# SHL Arena display box. Generated by render.sh from sway.config.template and
# /etc/shl-arena/display.env: edit those, not this file.

# --- outputs (logical pixels; the pages are authored at 1080x1920 and 1920x360) ---
# Portrait 24" screens rotated; the bar centred between them, as in config/wall.json.
output ${OUT_LEFT} transform ${ROTATE_LEFT} position 0 0 scale 1
output ${OUT_BAR} ${BAR_MODE_LINE} position 1080 780 scale 1
output ${OUT_RIGHT} transform ${ROTATE_RIGHT} position 3000 0 scale 1

# One workspace per screen.
workspace 1 output ${OUT_LEFT}
workspace 2 output ${OUT_BAR}
workspace 3 output ${OUT_RIGHT}

# --- kiosk look ---
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 1000
# no bar, no idle blanking (screen-power.sh decides when the screens sleep), and no
# X11: Chromium runs on Wayland
xwayland disable

# Each page to its screen, by its title, even when Chromium is restarted.
for_window [title="^SHL Arena – left"] move container to workspace number 1, fullscreen enable
for_window [title="^SHL Arena – bar"] move container to workspace number 2, fullscreen enable
for_window [title="^SHL Arena – right"] move container to workspace number 3, fullscreen enable

# --- start the kiosk (systemd user units) ---
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec systemctl --user start shl-kiosk.service shl-screen-power.timer
