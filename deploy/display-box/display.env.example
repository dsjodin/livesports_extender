# SHL Arena display box settings. install.sh copies this to /etc/shl-arena/display.env
# the first time; edit that file and run `sudo /opt/shl-arena-display/render.sh` (or
# reboot) after a change. docs/DEPLOY.md explains every line.

# Where the SHL Arena service runs (the Docker host).
ARENA_URL=http://lnx01:8010

# sway output names. Find them with `swaymsg -t get_outputs` (or `check.sh`) after the
# first boot. Typical on a Beelink SER8: DP-1, DP-2 (USB-C) and HDMI-A-1.
OUT_LEFT=DP-1
OUT_BAR=HDMI-A-1
OUT_RIGHT=DP-2

# Portrait screens: 90 or 270, whichever puts the top of the picture at the top.
ROTATE_LEFT=90
ROTATE_RIGHT=90

# The bar's mode. If its EDID offers no 1920x360 mode, set BAR_CUSTOM_MODE=1 and sway
# forces it as a custom mode.
BAR_MODE=1920x360@60Hz
BAR_CUSTOM_MODE=0

# Screen power: "dpms" (sway turns the outputs off), "ha" (a Home Assistant switch,
# e.g. a smart plug for all three screens) or "none" (always on).
SCREEN_POWER=dpms
# Screens are on during these hours (local time), and always while a game is selected
# and not idle on the service. Empty = only while a game is on.
SCREENS_ON_FROM=17:00
SCREENS_ON_UNTIL=23:30

# Only for SCREEN_POWER=ha: a long-lived access token (HA profile → Security) and the
# switch that powers the screens.
HA_URL=http://homeassistant:8123
HA_TOKEN=
HA_SWITCH=switch.skarmar

# Chromium binary and extra flags (normally empty).
CHROMIUM=chromium
CHROMIUM_EXTRA_FLAGS=
